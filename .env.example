# Names only. Never commit real values. Never prefix these with NEXT_PUBLIC_.

# YouCam API key. Server routes only. Bearer token for https://yce-api-01.makeupar.com
YOUCAM_API_KEY=

# AIML API (OpenAI-compatible). Optional. Demo mode never needs it.
AIML_API_KEY=
AIML_MODEL=
AIML_BASE_URL=

# Live-mode guards. Defaults: 150 units/day, 2 runs per IP, 60 units reserved per run.
DAILY_UNIT_CAP=
LIVE_RUNS_PER_IP=
SESSION_UNIT_BUDGET=

# Optional shared daily ledger. Upstash wins when both are set.
# Without either, the per-visitor cap still travels in an httpOnly cookie,
# and the daily ceiling is per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Created by adding a Blob store on the Vercel project (Storage, not Marketplace).
# Vercel injects this. Do not prefix it with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Salt for hashing visitor IPs in the unit ledger. Optional.
IP_HASH_SALT=
