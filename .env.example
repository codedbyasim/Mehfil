# Names only. Never commit real values. Never prefix these with NEXT_PUBLIC_.

# YouCam API key. Server routes only. Bearer token for https://yce-api-01.makeupar.com
YOUCAM_API_KEY=

# AIML API (OpenAI-compatible). Optional. Demo mode never needs it.
AIML_API_KEY=
AIML_MODEL=
AIML_BASE_URL=

# Optional store for one run's reservation. Not required. Live mode has no per-user limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Same role as Upstash when Upstash is unset.
# Vercel injects this when a Blob store exists. Do not prefix it with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=

# Salt for hashing visitor IPs into the run token. Optional.
IP_HASH_SALT=
